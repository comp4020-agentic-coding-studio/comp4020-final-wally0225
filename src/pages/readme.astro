---
// README.md, rendered: what this app is and what good means for it,
// published with the app. spec/invariants.test.ts checks its headings are here.
import * as readme from "../../README.md";
import Layout from "../layouts/Layout.astro";

const title = readme.getHeadings().find((h) => h.depth === 1)?.text ?? "About";
const html = await readme.compiledContent();
---

<Layout title={title} active="about">
  <article class="prose" set:html={html} />
</Layout>
