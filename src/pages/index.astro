---
import Avatar from "../components/Avatar.astro";
import Icon from "../components/Icon.astro";
import InviteCard from "../components/InviteCard.astro";
import MapView from "../components/MapView.astro";
import WeekView from "../components/WeekView.astro";
import SortSwitch from "../components/SortSwitch.astro";
import SpotPicker from "../components/SpotPicker.astro";
import Layout from "../layouts/Layout.astro";
import { LATE_CUTOFF_MINUTES, MAX_HOURS, MAX_SIZE, canJoin, listPast, listUpcoming } from "../lib/db";
import { hostingGroups, listGroups } from "../lib/groups";
import { currentPerson } from "../lib/identity";
import { messageCounts } from "../lib/chat";
import { TAGS } from "../lib/tags";
import { TIME_SLOTS, nextStep, toLocalInput } from "../lib/time";

const person = currentPerson(Astro.cookies);
const now = new Date();
// the groups this person is in, and the ones they can post in
const groupsIn = new Set(person ? listGroups(person.id).filter((g) => g.role).map((g) => g.id) : []);
const canPostIn = person ? hostingGroups(person.id) : [];
// "Post a Vybe in this group" on a group's page links here with ?group=
const presetGroup = Number(Astro.url.searchParams.get("group"));
const upcoming = person ? listUpcoming(now, person.id) : [];
const past = person ? listPast(person.id, now) : [];
const mine = upcoming.filter((i) => i.going.some((g) => g.id === person?.id));
const open = upcoming.filter((i) => !mine.includes(i) && canJoin(i, now));
// how many messages each of your Vybes' chats holds, for its Chat button
const chats = messageCounts(mine.map((i) => i.id));

// The form starts on the next five-minute step, running an hour.
const today = toLocalInput(now).slice(0, 10);
const [defaultDate, defaultStart] = toLocalInput(nextStep(now)).split("T");
const defaultEnd = toLocalInput(new Date(nextStep(now).getTime() + 3_600_000)).slice(11);

const errors: Record<string, string> = {
  name: "Give a name between 1 and 40 characters.",
  details: "Say what it is and where (up to 80 characters each).",
  time: "Pick a start time that hasn't passed yet.",
  end: `Pick an end time after the start, at most ${MAX_HOURS} hours later.`,
  size: `A group is between 2 and ${MAX_SIZE} people, you included.`,
  spot: "Tap the map where it is, somewhere near ANU.",
  full: "That one filled up just before you joined.",
  gone: "Joining that one has closed.",
  arrival: `Pick a time to get there at least ${LATE_CUTOFF_MINUTES} minutes before it ends.`,
  "not-host": "Only the person who posted a Vybe can cancel it.",
  "not-group-host": "Only a group's hosts can post Vybes in it.",
  tag: "Pick what kind of Vybe it is from the list.",
  members: "That Vybe is for a group's members. Join the group first, then join the Vybe.",
};
const error = errors[Astro.url.searchParams.get("error") ?? ""];
// a refused post opens the form again, so the reason is next to what to fix
const postRefused = ["details", "time", "end", "size", "spot", "not-group-host"].includes(Astro.url.searchParams.get("error") ?? "");
---

<Layout title="Vybe" active="invites">
  {
    error && (
      <p class="toast" role="alert">
        <Icon name="alert" />
        {error}
      </p>
    )
  }

  {
    !person ? (
      <section class="hero">
        <h1>
          Find people to <span class="accent">do things</span> with
        </h1>
        <p class="lead">Post what you want to do, when and where. Anyone free can join until it's full.</p>
        <form method="post" action="/api/name" class="card stack">
          <label class="field">
            <span class="field__label">What should people call you?</span>
            <input name="name" required maxlength="40" autocomplete="given-name" placeholder="Your first name" />
          </label>
          <button class="button button--wide">Get started</button>
        </form>
      </section>
    ) : (
      <>
        <section class="hello">
          <div class="hello__who">
            <Avatar name={person.name} large />
            <div>
              <h1>Hi, {person.name}</h1>
              <p class="muted">What do you feel like doing?</p>
            </div>
          </div>
        </section>

        <div class="toolbar">
        <details class="post" id="post" open={postRefused || canPostIn.some((g) => g.id === presetGroup)}>
          <summary class="button post__toggle">
            <Icon name="plus" />
            Post a Vybe
          </summary>
          <form method="post" action="/api/invites" class="stack card post__form">
            {/* a title and a close button, shown when the form is a dialog (laptops) */}
            <div class="post__head">
              <h2>Post a Vybe</h2>
              <button type="button" class="post__close" aria-label="Close" data-post-close>
                <Icon name="plus" />
              </button>
            </div>
            <label class="field post__what">
              <span class="field__label">What</span>
              <input name="title" required maxlength="80" placeholder="Pickleball, doubles" />
            </label>
            <label class="field post__where">
              <span class="field__label">Where</span>
              <input name="place" required maxlength="80" placeholder="ANU Sport courts" />
            </label>
            <SpotPicker />
            <fieldset class="tagpick post__tag">
              <legend class="field__label">What kind of Vybe <span class="field__label--sub">(optional)</span></legend>
              <div class="tagpick__options">
                {Object.entries(TAGS).map(([value, t]) => (
                  <label class="tagpick__option">
                    <input type="radio" name="tag" value={value} />
                    <span><span aria-hidden="true">{t.emoji}</span>{t.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <fieldset class="when">
              <legend class="field__label">When</legend>
              <label class="field when__date">
                <span class="field__label field__label--sub">Date</span>
                <input name="date" type="date" required min={today} value={defaultDate} />
              </label>
              <label class="field">
                <span class="field__label field__label--sub">Starts</span>
                <select name="startTime" required>
                  {TIME_SLOTS.map((slot) => (
                    <option value={slot.value} selected={slot.value === defaultStart}>
                      {slot.label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="field">
                <span class="field__label field__label--sub">Ends</span>
                <select name="endTime" required>
                  {TIME_SLOTS.map((slot) => (
                    <option value={slot.value} selected={slot.value === defaultEnd}>
                      {slot.label}
                    </option>
                  ))}
                </select>
              </label>
            </fieldset>
            <label class="field post__size">
              <span class="field__label">How many people, you included</span>
              <input name="size" type="number" required min="2" max={MAX_SIZE} value="4" />
            </label>
            {/* hosts of a group can post in it, and make it a weekly regular */}
            {canPostIn.length > 0 && (
              <div class="post__group">
                <label class="field">
                  <span class="field__label">Post in</span>
                  <select name="group" data-post-group>
                    <option value="">Anyone can join</option>
                    {canPostIn.map((g) => (
                      <option value={g.id} selected={g.id === presetGroup}>{g.name} (members only)</option>
                    ))}
                  </select>
                </label>
                <fieldset class="repeat" data-post-repeat disabled={!canPostIn.some((g) => g.id === presetGroup)}>
                  <legend class="field__label">How often</legend>
                  <label class="repeat__option">
                    <input type="radio" name="repeat" value="once" checked />
                    <span>One-time</span>
                  </label>
                  <label class="repeat__option">
                    <input type="radio" name="repeat" value="weekly" />
                    <span><Icon name="repeat" />Every week</span>
                  </label>
                </fieldset>
              </div>
            )}
            <button class="button button--wide post__submit">Post Vybe</button>
          </form>
        </details>
        {/* List | Map, on phones; MapView's script drives it */}
        <div class="viewswitch" role="group" aria-label="Show Vybes as">
          <button type="button" class="viewswitch__button" data-view-button="list" aria-pressed="true">List</button>
          <button type="button" class="viewswitch__button" data-view-button="map" aria-pressed="false">Map</button>
          <button type="button" class="viewswitch__button" data-view-button="week" aria-pressed="false">Week</button>
        </div>
        </div>

        <p class="notice" role="status" data-notice hidden />

        {/* on a phone, the list or the map; on a laptop, both side by side */}
        <div class="browse">
        <WeekView />
        <MapView />

        <section aria-labelledby="your-plans" class="section" data-live="your-plans">
          <div class="section__head">
            <h2 id="your-plans">Your Vybes</h2>
            {mine.length > 0 && <span class="pill">{mine.length}</span>}
          </div>
          {mine.length === 0 ? (
            <p class="empty">Nothing yet. Join something below, or post your own.</p>
          ) : (
            <ul class="invites">
              {mine.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="mine" groupsIn={groupsIn} messages={chats.get(invite.id)} />
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="open-invites" class="section" data-live="open-invites">
          <div class="section__head">
            <h2 id="open-invites">Open Vybes</h2>
            {open.length > 0 && <span class="pill">{open.length}</span>}
            <SortSwitch hidden={open.length < 2} />
          </div>
          {/* filter by tag; the page hides cards, so nothing about it reaches the server */}
          {open.length > 1 && (
            <div class="tagfilter" role="group" aria-label="Show only">
              <button type="button" class="tagfilter__chip" data-tag-filter="" aria-pressed="true">All</button>
              {Object.entries(TAGS)
                .filter(([value]) => open.some((i) => i.tag === value))
                .map(([value, t]) => (
                  <button type="button" class="tagfilter__chip" data-tag-filter={value} aria-pressed="false">
                    <span aria-hidden="true">{t.emoji}</span>{t.label}
                  </button>
                ))}
            </div>
          )}
          {open.length === 0 ? (
            <p class="empty">No open Vybes right now. Be the first to post one.</p>
          ) : (
            <ul class="invites">
              {open.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="open" groupsIn={groupsIn} />
              ))}
            </ul>
          )}
        </section>
        </div>


        {past.length > 0 && (
          <section aria-labelledby="past-plans" class="section">
            <div class="section__head">
              <h2 id="past-plans">Past plans</h2>
            </div>
            <ul class="invites">
              {past.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="past" />
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</Layout>

<script>
  // Post a Vybe as a dialog on laptops: × , Esc, or a click on the backdrop
  // (the details element itself, outside the form) closes it.
  const post = document.querySelector<HTMLDetailsElement>("details.post");
  if (post) {
    post.querySelector("[data-post-close]")?.addEventListener("click", () => (post.open = false));
    post.addEventListener("click", (e) => {
      if (e.target === post) post.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && post.open) {
        post.open = false;
        post.querySelector("summary")?.focus();
      }
    });
    // tapping the chosen tag again un-chooses it, since a tag is optional
    for (const radio of post.querySelectorAll<HTMLInputElement>('input[name="tag"]')) {
      radio.addEventListener("pointerdown", () => (radio.dataset.was = String(radio.checked)));
      radio.addEventListener("click", () => {
        if (radio.dataset.was === "true") radio.checked = false;
      });
    }
    // a Vybe can only repeat in a group
    const groupSelect = post.querySelector<HTMLSelectElement>("[data-post-group]");
    const repeat = post.querySelector<HTMLFieldSetElement>("[data-post-repeat]");
    groupSelect?.addEventListener("change", () => {
      if (!repeat) return;
      repeat.disabled = !groupSelect.value;
      if (!groupSelect.value) repeat.querySelector<HTMLInputElement>('input[value="once"]')!.checked = true;
    });
    // straight to the first field when it opens
    post.addEventListener("toggle", () => {
      if (post.open) post.querySelector<HTMLInputElement>("input[name=title]")?.focus({ preventScroll: true });
    });
  }
</script>

<script>
  // Live updates: the sections marked data-live are refetched whenever the
  // server says an invite changed, so one person's post or join shows on
  // everyone else's page without a reload. The post form isn't touched.
  const live = () => document.querySelectorAll<HTMLElement>("[data-live]");

  // Someone choosing when they'll get there is mid-join: swapping the card
  // under them would reset the dropdown or move the button they're about to
  // press. Updates wait until they leave the form, and if the last spot goes
  // in the meantime, the join is refused and they're told it filled up.
  const joining = () => document.activeElement?.closest("form.join") != null;
  let held = false;

  // Coming back to the page (the phone woke, the connection came back, the
  // tab was in the background) refreshes it without asking, then says how
  // many invites changed, so things moving around isn't a mystery.
  let returning = false;
  const missed = new Set<string>();

  // What each card says people can change: that it exists, and how many are
  // going. The rest of a card ("in 20 min", "Starting soon") changes with the
  // clock, which isn't news.
  function snapshot(): Map<string, string> {
    const cards = new Map<string, string>();
    for (const card of document.querySelectorAll<HTMLElement>("[data-live] [data-going]")) {
      cards.set(card.id, card.dataset.going!);
    }
    return cards;
  }

  async function refresh() {
    const res = await fetch("/");
    if (!res.ok) return;
    const next = new DOMParser().parseFromString(await res.text(), "text/html");
    // checked once the page has arrived, since they may have started joining
    // while it was on its way; the update is fetched again when they're done
    if (joining()) {
      held = true;
      return;
    }
    held = false;
    const away = returning || document.hidden;
    returning = false;

    // a Join that's been opened stays open, and an arrival time already
    // picked stays picked, if the card still offers it
    const picked = new Map<string, string>();
    const opened = new Set<string>();
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-live] form.join")) {
      if (form.arrival instanceof HTMLSelectElement) picked.set(form.invite.value, form.arrival.value);
      if (form.querySelector("details[open]")) opened.add(form.invite.value);
    }

    const before = snapshot();
    for (const section of live()) {
      const fresh = next.querySelector(`[data-live="${section.dataset.live}"]`);
      if (fresh) section.replaceWith(fresh);
    }
    const after = snapshot();
    watchCards();
    document.dispatchEvent(new CustomEvent("vybe:cards"));

    for (const form of document.querySelectorAll<HTMLFormElement>("[data-live] form.join")) {
      const details = form.querySelector("details");
      if (details && opened.has(form.invite.value)) details.open = true;
      const arrival = picked.get(form.invite.value);
      const select = form.arrival;
      if (arrival && select instanceof HTMLSelectElement && [...select.options].some((o) => o.value === arrival)) {
        select.value = arrival;
      }
    }

    // new, joined, left, or gone (ended, so off the list)
    const changed = [...after].filter(([id, going]) => before.get(id) !== going).map(([id]) => id);
    const gone = [...before.keys()].filter((id) => !after.has(id));

    if (away) {
      for (const id of [...changed, ...gone]) missed.add(id);
      // nobody's looking yet; the note waits until they are
      if (document.hidden) return;
      tell(missed.size);
      highlight([...missed]);
      missed.clear();
    } else {
      highlight(changed);
    }
  }

  let hideNotice: number | undefined;
  function tell(count: number) {
    const notice = document.querySelector<HTMLElement>("[data-notice]");
    if (!notice || count === 0) return;
    notice.textContent = `${count} ${count === 1 ? "Vybe" : "Vybes"} changed while you were away`;
    notice.hidden = false;
    clearTimeout(hideNotice);
    hideNotice = window.setTimeout(() => (notice.hidden = true), 8000);
  }

  function highlight(ids: string[]) {
    for (const id of ids) {
      const card = document.getElementById(id);
      if (!card) continue;
      card.classList.add("invite--changed");
      setTimeout(() => card.classList.remove("invite--changed"), 2500);
    }
  }

  // The viewer count: a card at least half on screen counts this person as
  // looking, and on the map, a pin inside the visible area does. The page
  // tells the server which invites those are, and shows on each card (and
  // pin) how many others are looking at it, never who. A hidden tab or a
  // locked phone isn't looking at anything.
  let stream: string | undefined;
  let counts: Record<string, number> = {};
  const onScreen = new Set<number>();
  // the invites whose pins are in view, from the map (see MapView.astro)
  let onMap: number[] = [];
  let lastReport = "";
  let reportPending: number | undefined;

  function report() {
    clearTimeout(reportPending);
    if (!stream) return;
    // on a laptop ("both") the list and the map are both on screen
    const view = document.documentElement.dataset.view;
    const showing =
      view === "map" ? onMap : view === "both" ? [...new Set([...onMap, ...onScreen])] : [...onScreen];
    const invites = document.hidden ? [] : [...showing].sort((a, b) => a - b);
    const body = JSON.stringify({ stream, invites });
    if (body === lastReport) return;
    lastReport = body;
    fetch("/api/viewing", { method: "POST", headers: { "content-type": "application/json" }, body, keepalive: true }).catch(
      () => {},
    );
  }

  // scrolling changes what's on screen many times a second; report once it settles
  const reportSoon = () => {
    clearTimeout(reportPending);
    reportPending = window.setTimeout(report, 300);
  };

  const cards = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const invite = Number(entry.target.id.replace("invite-", ""));
        if (entry.isIntersecting) onScreen.add(invite);
        else onScreen.delete(invite);
      }
      reportSoon();
    },
    { threshold: 0.5 },
  );

  // the cards are new elements after every swap, so they're watched afresh
  function watchCards() {
    cards.disconnect();
    onScreen.clear();
    for (const card of document.querySelectorAll("[data-live] [data-going]")) cards.observe(card);
    showCounts();
  }

  // on the cards in the list, the copies in an open map popup (which carry
  // the invite they copy as data-invite), and the pins
  function showCounts() {
    for (const card of document.querySelectorAll<HTMLElement>("[data-live] [data-going], [data-invite]")) {
      const label = card.querySelector<HTMLElement>("[data-viewers]");
      if (!label) continue;
      const others = counts[(card.id || card.dataset.invite!).replace("invite-", "")] ?? 0;
      label.hidden = others === 0;
      label.textContent = `${others} ${others === 1 ? "other" : "others"} looking`;
    }
    document.dispatchEvent(new CustomEvent("vybe:viewers", { detail: counts }));
  }

  if (live().length > 0) {
    // several changes close together (six people joining at once) make one
    // refetch, not six
    let pending: number | undefined;
    const soon = () => {
      clearTimeout(pending);
      pending = window.setTimeout(refresh, 150);
    };
    const comeBack = () => {
      returning = true;
      soon();
    };

    const events = new EventSource("/api/events");
    events.addEventListener("change", soon);
    // a new message in one of your Vybes' chats: its Chat button's count moves
    events.addEventListener("chat", soon);
    // every connection, the first and each reconnect, gets a new id, and the
    // server knows nothing about what this page shows until it's told again
    events.addEventListener("hello", (e) => {
      stream = JSON.parse(e.data).stream;
      lastReport = "";
      report();
    });
    events.addEventListener("viewers", (e) => {
      counts = JSON.parse(e.data);
      showCounts();
    });
    // the map says which pins are in view as you pan, zoom and switch views
    document.addEventListener("vybe:map-viewing", (e) => {
      onMap = (e as CustomEvent<number[]>).detail;
      reportSoon();
    });
    watchCards();
    // the first open is the page loading; any later one is a reconnect, and
    // whatever changed while it was down never arrived as an event
    let opened = false;
    events.addEventListener("open", () => {
      if (opened) comeBack();
      opened = true;
    });
    document.addEventListener("visibilitychange", () => {
      // hiding reports nothing on screen straight away, so the count drops
      report();
      if (!document.hidden) comeBack();
    });

    // focus moving from the dropdown to the Join button is still joining, so
    // wait a moment to see where it lands
    document.addEventListener("focusout", () => {
      setTimeout(() => {
        if (held && !joining()) refresh();
      });
    });
  }
</script>

<script>
  // The tag filter: shows only open Vybes with the chosen tag. It's put back
  // after every live update, which swaps in fresh cards and a fresh row.
  let chosen = "";
  function applyFilter() {
    for (const chip of document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]")) {
      chip.setAttribute("aria-pressed", String(chip.dataset.tagFilter === chosen));
    }
    // a tag that's no longer on any card falls back to All
    if (chosen && !document.querySelector(`[data-tag-filter="${chosen}"]`)) chosen = "";
    for (const card of document.querySelectorAll<HTMLElement>('[data-live="open-invites"] .invites > li')) {
      card.hidden = !!chosen && card.dataset.tag !== chosen;
    }
  }
  document.addEventListener("click", (e) => {
    const chip = (e.target as Element).closest<HTMLButtonElement>("[data-tag-filter]");
    if (!chip) return;
    chosen = chip.dataset.tagFilter ?? "";
    applyFilter();
  });
  document.addEventListener("vybe:cards", applyFilter);
</script>
