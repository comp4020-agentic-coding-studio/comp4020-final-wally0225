---
import Avatar from "../components/Avatar.astro";
import Icon from "../components/Icon.astro";
import InviteCard from "../components/InviteCard.astro";
import Layout from "../layouts/Layout.astro";
import { LATE_CUTOFF_MINUTES, MAX_HOURS, MAX_SIZE, canJoin, listPast, listUpcoming } from "../lib/db";
import { currentPerson } from "../lib/identity";
import { TIME_SLOTS, nextStep, toLocalInput } from "../lib/time";

const person = currentPerson(Astro.cookies);
const now = new Date();
const upcoming = person ? listUpcoming(now) : [];
const past = person ? listPast(person.id, now) : [];
const mine = upcoming.filter((i) => i.going.some((g) => g.id === person?.id));
const open = upcoming.filter((i) => !mine.includes(i) && canJoin(i, now));

// The form starts on the next five-minute step, running an hour.
const today = toLocalInput(now).slice(0, 10);
const [defaultDate, defaultStart] = toLocalInput(nextStep(now)).split("T");
const defaultEnd = toLocalInput(new Date(nextStep(now).getTime() + 3_600_000)).slice(11);

const errors: Record<string, string> = {
  name: "Give a name between 1 and 40 characters.",
  details: "Say what it is and where (up to 80 characters each).",
  time: "Pick a start time that hasn't passed yet.",
  end: `Pick an end time after the start, at most ${MAX_HOURS} hours later.`,
  size: `A group is between 2 and ${MAX_SIZE} people, you included.`,
  full: "That one filled up just before you joined.",
  gone: "Joining that one has closed.",
  arrival: `Pick a time to get there at least ${LATE_CUTOFF_MINUTES} minutes before it ends.`,
};
const error = errors[Astro.url.searchParams.get("error") ?? ""];
---

<Layout title="Vybe" active="invites">
  {
    error && (
      <p class="toast" role="alert">
        <Icon name="alert" />
        {error}
      </p>
    )
  }

  {
    !person ? (
      <section class="hero">
        <h1>
          Find people to <span class="accent">do things</span> with
        </h1>
        <p class="lead">Post what you want to do, when and where. Anyone free can join until it's full.</p>
        <form method="post" action="/api/name" class="card stack">
          <label class="field">
            <span class="field__label">What should people call you?</span>
            <input name="name" required maxlength="40" autocomplete="given-name" placeholder="Your first name" />
          </label>
          <button class="button button--wide">Get started</button>
        </form>
      </section>
    ) : (
      <>
        <section class="hello">
          <div class="hello__who">
            <Avatar name={person.name} large />
            <div>
              <h1>Hi, {person.name}</h1>
              <p class="muted">What do you feel like doing?</p>
            </div>
          </div>
          <a class="button" href="#post">
            <Icon name="plus" />
            Post an invite
          </a>
        </section>

        <section aria-labelledby="your-plans" class="section">
          <div class="section__head">
            <h2 id="your-plans">Your plans</h2>
            {mine.length > 0 && <span class="pill">{mine.length}</span>}
          </div>
          {mine.length === 0 ? (
            <p class="empty">Nothing yet. Join something below, or post your own.</p>
          ) : (
            <ul class="invites">
              {mine.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="mine" />
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="open-invites" class="section">
          <div class="section__head">
            <h2 id="open-invites">Open invites</h2>
            {open.length > 0 && <span class="pill">{open.length}</span>}
          </div>
          {open.length === 0 ? (
            <p class="empty">No open invites right now. Be the first to post one.</p>
          ) : (
            <ul class="invites">
              {open.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="open" />
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="post" class="section card">
          <h2 id="post">Post an invite</h2>
          <form method="post" action="/api/invites" class="stack">
            <label class="field">
              <span class="field__label">What</span>
              <input name="title" required maxlength="80" placeholder="Pickleball, doubles" />
            </label>
            <label class="field">
              <span class="field__label">Where</span>
              <input name="place" required maxlength="80" placeholder="ANU Sport courts" />
            </label>
            <fieldset class="when">
              <legend class="field__label">When</legend>
              <label class="field when__date">
                <span class="field__label field__label--sub">Date</span>
                <input name="date" type="date" required min={today} value={defaultDate} />
              </label>
              <label class="field">
                <span class="field__label field__label--sub">Starts</span>
                <select name="startTime" required>
                  {TIME_SLOTS.map((slot) => (
                    <option value={slot.value} selected={slot.value === defaultStart}>
                      {slot.label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="field">
                <span class="field__label field__label--sub">Ends</span>
                <select name="endTime" required>
                  {TIME_SLOTS.map((slot) => (
                    <option value={slot.value} selected={slot.value === defaultEnd}>
                      {slot.label}
                    </option>
                  ))}
                </select>
              </label>
            </fieldset>
            <label class="field">
              <span class="field__label">How many people, you included</span>
              <input name="size" type="number" required min="2" max={MAX_SIZE} value="4" />
            </label>
            <button class="button button--wide">Post invite</button>
          </form>
        </section>

        {past.length > 0 && (
          <section aria-labelledby="past-plans" class="section">
            <div class="section__head">
              <h2 id="past-plans">Past plans</h2>
            </div>
            <ul class="invites">
              {past.map((invite) => (
                <InviteCard invite={invite} now={now} personId={person.id} variant="past" />
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</Layout>
