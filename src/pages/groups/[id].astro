---
import Avatar from "../../components/Avatar.astro";
import Icon from "../../components/Icon.astro";
import InviteCard from "../../components/InviteCard.astro";
import Layout from "../../layouts/Layout.astro";
import { listUpcoming } from "../../lib/db";
import {
  COVERS,
  MAX_GROUP_ABOUT,
  MAX_GROUP_NAME,
  canHost,
  coverOf,
  coverUrl,
  getGroup,
  groupHue,
  listMembers,
} from "../../lib/groups";
import { currentPerson } from "../../lib/identity";
import { TAGS } from "../../lib/tags";

// One group: its upcoming Vybes, who's in it and what they can do, and for
// its owner and hosts, managing it. What a button offers here, the server
// checks again (src/lib/groups.ts).
const person = currentPerson(Astro.cookies);
if (!person) return Astro.redirect("/");

const id = Number(Astro.params.id);
const group = Number.isInteger(id) ? getGroup(id, person.id) : undefined;
if (!group) return new Response("No such group", { status: 404 });

const now = new Date();
const vybes = listUpcoming(now, person.id).filter((i) => i.groupId === group.id);
const people = listMembers(group.id);
const owner = group.role === "owner";
const host = canHost(group.role);
const groupsIn = new Set(group.role ? [group.id] : []);

const errors: Record<string, string> = {
  "not-host": "Only the group's hosts can make someone a host.",
  "not-owner": "Only the group's owner can do that.",
  owner: "The owner's role can't change, and the owner can't leave.",
  "not-member": "They're not in the group any more.",
  name: `Give the group a name (up to ${MAX_GROUP_NAME} characters).`,
  cover: "Pick one of the covers shown.",
};
const error = errors[Astro.url.searchParams.get("error") ?? ""];
const roleLabel = { owner: "Owner", host: "Host", member: "Member" } as const;
const hue = groupHue(group.name);
const hosts = people.filter((m) => m.role !== "member").length;
const weekly = vybes.filter((i) => i.repeat === "weekly").length;
const faces = people.slice(0, 5);
const cover = coverOf(group);
---

<Layout title={`${group.name} · Vybe`} active="groups">
  <a class="backlink" href="/groups"><Icon name="chevron-left" />Groups</a>

  <section class="ghero" style={`--hue: ${hue}`}>
    <div class="ghero__cover" aria-hidden="true">
      <img src={coverUrl(cover)} alt="" />
    </div>
    <div class="ghero__main">
      <span class="ghero__mark" aria-hidden="true">{group.name.slice(0, 1).toUpperCase()}</span>
      <div class="ghero__body">
        <h1>{group.name}</h1>
        {group.about && <p class="ghero__about">{group.about}</p>}
        {group.role && (
          <span class={`badge badge--role badge--${group.role}`}>
            You're {group.role === "member" ? "a member" : `the ${roleLabel[group.role].toLowerCase()}`}
          </span>
        )}
      </div>
      <div class="ghero__actions">
        {host && (
          <a class="button" href={`/?group=${group.id}#post`}><Icon name="plus" />Post a Vybe here</a>
        )}
        {!group.role && (
          <form method="post" action="/api/groups">
            <input type="hidden" name="action" value="join" />
            <input type="hidden" name="group" value={group.id} />
            <button class="button">Join group</button>
          </form>
        )}
        {group.role && !owner && (
          <form method="post" action="/api/groups">
            <input type="hidden" name="action" value="leave" />
            <input type="hidden" name="group" value={group.id} />
            <button class="button button--ghost">Leave group</button>
          </form>
        )}
      </div>
    </div>
    <div class="ghero__foot">
      <dl class="gstats">
        <div><dt>Members</dt><dd>{group.memberCount}</dd></div>
        <div><dt>Upcoming</dt><dd>{vybes.length}</dd></div>
        <div><dt>Hosts</dt><dd>{hosts}</dd></div>
        <div><dt>Weekly</dt><dd>{weekly}</dd></div>
      </dl>
      <div class="ghero__faces avatars" aria-hidden="true">
        {faces.map((m) => <Avatar name={m.name} />)}
        {people.length > faces.length && <span class="avatar avatar--more">+{people.length - faces.length}</span>}
      </div>
    </div>
  </section>

  {error && <p class="toast" role="alert"><Icon name="alert" />{error}</p>}

  <div class="glayout" style={`--hue: ${hue}`}>
  <section class="section glayout__main">
    <div class="section__head">
      <h2>Upcoming</h2>
      {vybes.length > 0 && <span class="pill">{vybes.length}</span>}
    </div>
    {
      vybes.length === 0 ? (
        <p class="empty">{host ? "Nothing planned. Post the first Vybe, or a weekly one." : "Nothing planned yet."}</p>
      ) : (
        <ul class="invites invites--cards">
          {vybes.map((invite) => (
            <InviteCard
              invite={invite}
              now={now}
              personId={person.id}
              variant={invite.going.some((g) => g.id === person.id) ? "mine" : "open"}
              groupsIn={groupsIn}
              cover={cover}
            />
          ))}
        </ul>
      )
    }
  </section>

  <aside class="glayout__side">
  <section class="section">
    <div class="section__head">
      <h2>Members</h2>
      <span class="pill">{people.length}</span>
    </div>
    {/* who can do what: owner and hosts post; hosts make hosts; only the owner takes it back or removes */}
    <ul class="membergrid">
      {people.map((m) => (
        <li class={`mcard mcard--${m.role}`}>
          {m.role !== "owner" && owner && (
            <form method="post" action="/api/groups" class="mcard__remove">
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="group" value={group.id} />
              <input type="hidden" name="person" value={m.id} />
              <button class="iconbutton" aria-label={`Remove ${m.name} from the group`} title="Remove from group">
                <Icon name="x" />
              </button>
            </form>
          )}
          <Avatar name={m.name} large />
          <span class="mcard__name">
            {m.name}
            {m.id === person.id && <span class="muted"> (you)</span>}
          </span>
          <span class={`badge badge--role badge--${m.role}`}>{roleLabel[m.role]}</span>
          <span class="mcard__actions">
          {m.role === "member" && host && (
            <form method="post" action="/api/groups">
              <input type="hidden" name="action" value="role" />
              <input type="hidden" name="group" value={group.id} />
              <input type="hidden" name="person" value={m.id} />
              <input type="hidden" name="role" value="host" />
              <button class="button button--ghost button--small">Make host</button>
            </form>
          )}
          {m.role === "host" && owner && (
            <form method="post" action="/api/groups">
              <input type="hidden" name="action" value="role" />
              <input type="hidden" name="group" value={group.id} />
              <input type="hidden" name="person" value={m.id} />
              <input type="hidden" name="role" value="member" />
              <button class="button button--ghost button--small">Remove host</button>
            </form>
          )}
          </span>
        </li>
      ))}
    </ul>
  </section>

  {
    owner && (
      <section class="section">
        <details class="settings card">
          <summary>Group settings</summary>
          <form method="post" action="/api/groups" class="stack">
            <input type="hidden" name="action" value="update" />
            <input type="hidden" name="group" value={group.id} />
            <label class="field">
              <span class="field__label">Name</span>
              <input name="name" required maxlength={MAX_GROUP_NAME} value={group.name} />
            </label>
            <label class="field">
              <span class="field__label">What it's about</span>
              <textarea name="about" maxlength={MAX_GROUP_ABOUT} rows="2">{group.about}</textarea>
            </label>
            <fieldset class="field coverpick">
              <legend class="field__label">Cover</legend>
              <div class="coverpick__grid">
                {COVERS.map((c) => (
                  <label class="coverpick__option">
                    <input type="radio" name="cover" value={c} checked={c === cover} />
                    <img src={coverUrl(c)} alt="" loading="lazy" />
                    <span>{TAGS[c].label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <button class="button">Save</button>
          </form>
        </details>
      </section>
    )
  }
  </aside>
  </div>
</Layout>
