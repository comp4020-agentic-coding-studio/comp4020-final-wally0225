---
import "../styles.css";

interface Props {
  title: string;
  active: "invites" | "about";
}

const { title, active } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__name" href="/">Vybe</a>
      <nav aria-label="site">
        <a href="/" aria-current={active === "invites" ? "page" : undefined}>Invites</a>
        <a href="/readme/" aria-current={active === "about" ? "page" : undefined}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
