---
import "../styles.css";

interface Props {
  title: string;
  active: "invites" | "about";
}

const { title, active } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f8f8" />
    <title>{title}</title>
  </head>
  <body>
    <header class="appbar">
      <div class="appbar__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">V</span>
          <span>Vybe</span>
        </a>
        <nav aria-label="site" class="tabs">
          <a href="/" aria-current={active === "invites" ? "page" : undefined}>Invites</a>
          <a href="/readme/" aria-current={active === "about" ? "page" : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
