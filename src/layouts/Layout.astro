---
import "../styles.css";
import Icon from "../components/Icon.astro";
import MaterialIcon from "../components/MaterialIcon.astro";
import { currentPerson } from "../lib/identity";

interface Props {
  title: string;
  active: "invites" | "groups" | "about";
}

const { title, active } = Astro.props;
const person = currentPerson(Astro.cookies);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f8f8" />
    <title>{title}</title>
    <script is:inline>
      // light or dark before first paint: the person's choice if they made
      // one, otherwise the system's
      try {
        var saved = localStorage.getItem("vybe-theme");
        var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = dark ? "#0f1415" : "#f4f8f8";
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="appbar">
      <div class="appbar__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">V</span>
          <span>Vybe</span>
        </a>
        <div class="appbar__end">
        <nav aria-label="site" class="tabs">
          {/* on phones, signed in, Vybes and Groups move to the bar at the bottom */}
          <a href="/" class={person ? "tabs__moved" : undefined} aria-current={active === "invites" ? "page" : undefined}>Vybes</a>
          {person && <a href="/groups" class="tabs__moved" aria-current={active === "groups" ? "page" : undefined}>Groups</a>}
          <a href="/readme/" aria-current={active === "about" ? "page" : undefined}>About</a>
        </nav>
        {person && (
          <form method="post" action="/api/logout">
            <button class="logout" title={`Log out ${person.name}`}>Log out</button>
          </form>
        )}
        <button type="button" class="themetoggle" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
          <span class="themetoggle__moon"><Icon name="sun" /></span>
          <span class="themetoggle__sun"><Icon name="moon" /></span>
        </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {
      person && (
        <nav class="bottomnav" aria-label="main">
          <a href="/" aria-current={active === "invites" ? "page" : undefined}>
            <MaterialIcon name="home" />
            <span>Home</span>
          </a>
          {/* on the home page the script opens the form in place; elsewhere this goes there with it open */}
          <a href="/?post=1#post" data-post-open aria-label="Post a Vybe" aria-pressed="false">
            <MaterialIcon name="add_circle" />
            <span>Vybe</span>
          </a>
          <a href="/groups" aria-current={active === "groups" ? "page" : undefined}>
            <MaterialIcon name="groups" />
            <span>Groups</span>
          </a>
        </nav>
      )
    }
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const label = () => {
        const next = root.dataset.theme === "dark" ? "Switch to light mode" : "Switch to dark mode";
        toggle?.setAttribute("aria-label", next);
        toggle?.setAttribute("title", next);
      };
      label();
      toggle?.addEventListener("click", () => {
        const dark = root.dataset.theme !== "dark";
        root.dataset.theme = dark ? "dark" : "light";
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = dark ? "#0f1415" : "#f4f8f8";
        try {
          localStorage.setItem("vybe-theme", dark ? "dark" : "light");
        } catch {
          // private window: it still switches, it just isn't remembered
        }
        label();
      });
    </script>
  </body>
</html>
