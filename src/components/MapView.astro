---
// "Close enough to just go": the invites on a map, opening on about a
// kilometre around where you are (or ANU, if the browser can't say). On a
// phone the List | Map switch (in index.astro) picks which one the page
// shows; on a laptop the map sits beside the list. The pins come from the cards
// already on the page, so a pin always says what its card says, live updates
// included.
---

<section class="section mapview" aria-label="Vybes on a map" data-mapview>
  <div class="mapview__map" data-map></div>
  <p class="muted mapview__status" data-map-status role="status"></p>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { ANU, START_KM } from "../lib/geo";
  import { type Spot, locate } from "../lib/locate";

  const box = document.querySelector<HTMLElement>("[data-map]");
  const status = document.querySelector<HTMLElement>("[data-map-status]");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-view-button]");

  let map: L.Map | undefined;
  const pins = L.layerGroup();
  // each pin and how many invites it stands for, for "N invites in this area"
  let placed: { pin: L.Marker; ids: string[] }[] = [];
  // how many others are looking at each invite, from the live stream
  let counts: Record<string, number> = {};
  let you: L.CircleMarker | undefined;
  // the spot whose popup is open, so a live refresh can reopen it
  let openSpot: string | undefined;
  // true once the browser couldn't say where they are, so the map is on ANU
  let onAnu = false;

  // which view this device last used; only a convenience, so it's fine if
  // storage isn't there
  const remembered = (): string | null => {
    try {
      return localStorage.getItem("vybe:view");
    } catch {
      return null;
    }
  };
  const remember = (view: string) => {
    try {
      localStorage.setItem("vybe:view", view);
    } catch {
      // private window or blocked storage
    }
  };

  // The cards the server sent, as pins. Invites at the same spot (within
  // about 10 m: two games on one court) share a pin showing how many, and its
  // popup lists all of them. Your own plans make the pin a different colour,
  // so they stand out wherever you've panned to. Invites posted before the
  // map existed have no spot, so no pin.
  function placePins() {
    if (!map) return;
    pins.clearLayers();
    placed = [];
    const spots = new Map<string, { lat: number; lng: number; cards: HTMLElement[] }>();
    for (const card of document.querySelectorAll<HTMLElement>("[data-live] [data-going]")) {
      const lat = Number(card.dataset.lat);
      const lng = Number(card.dataset.lng);
      if (!card.dataset.lat || !Number.isFinite(lat) || !Number.isFinite(lng)) continue;
      const key = `${lat.toFixed(4)},${lng.toFixed(4)}`;
      if (!spots.has(key)) spots.set(key, { lat, lng, cards: [] });
      spots.get(key)!.cards.push(card);
    }

    for (const [key, { lat, lng, cards }] of spots) {
      const mine = cards.some((card) => card.classList.contains("invite--mine"));
      const icon = L.divIcon({
        className: "",
        html:
          `<span class="pin${mine ? " pin--mine" : ""}">${cards.length > 1 ? cards.length : ""}</span>` +
          `<span class="pin__looking" hidden></span>`,
        iconSize: [28, 28],
      });
      const pin = L.marker([lat, lng], { icon, keyboard: true, title: cards.map((c) => titleOf(c)).join(", ") });
      pin.bindPopup(() => cardsFor(cards.map((c) => c.id)), {
        maxWidth: 300,
        minWidth: 240,
        // several invites at one spot scroll inside the popup, rather than
        // pushing the map (and the pin) out of view
        maxHeight: 360,
        autoPanPaddingTopLeft: [56, 16],
        autoPanPaddingBottomRight: [16, 16],
        className: "pin-popup",
      });
      pin.on("popupopen", () => (openSpot = key));
      pin.on("popupclose", () => {
        if (openSpot === key) openSpot = undefined;
      });
      pin.on("mouseover", () => cards.forEach((c) => hover(c.id, true)));
      pin.on("mouseout", () => cards.forEach((c) => hover(c.id, false)));
      pin.addTo(pins);
      placed.push({ pin, ids: cards.map((c) => c.id) });
      // a refresh rebuilds every pin; the one that was open stays open
      if (openSpot === key) pin.openPopup();
    }
    showLooking();
    countInView();
  }

  // The badge on each pin: how many others are looking. A pin for several
  // invites shows the most for any one of them: someone with that pin in view
  // is looking at all of them, so adding them up would count them twice.
  function showLooking() {
    for (const { pin, ids } of placed) {
      const badge = pin.getElement()?.querySelector<HTMLElement>(".pin__looking");
      if (!badge) continue;
      const others = Math.max(0, ...ids.map((id) => counts[id.replace("invite-", "")] ?? 0));
      badge.hidden = others === 0;
      badge.textContent = String(others);
      badge.title = `${others} ${others === 1 ? "other" : "others"} looking`;
    }
  }

  // what this person is looking at on the map: every invite with its pin in
  // view, or nothing while the list is showing
  function reportViewing() {
    const view = document.documentElement.dataset.view;
    const ids =
      map && (view === "map" || view === "both")
        ? placed
            .filter(({ pin }) => map!.getBounds().contains(pin.getLatLng()))
            .flatMap(({ ids }) => ids.map((id) => Number(id.replace("invite-", ""))))
        : [];
    document.dispatchEvent(new CustomEvent("vybe:map-viewing", { detail: ids }));
  }

  const titleOf = (card: HTMLElement) => card.querySelector(".invite__title")?.textContent ?? "Vybe";

  // The cards themselves, Join forms and all, so joining from the map is the
  // same as joining from the list.
  function cardsFor(ids: string[]): HTMLElement {
    const list = document.createElement("ul");
    list.className = "invites";
    for (const id of ids) {
      const card = document.getElementById(id)!.cloneNode(true) as HTMLElement;
      card.removeAttribute("id");
      // so the live counts can find the copy (see showCounts in index.astro)
      card.dataset.invite = id;
      card.classList.remove("invite--changed");
      list.append(card);
    }
    return list;
  }

  function countInView() {
    if (!map || !status) return;
    const bounds = map.getBounds();
    const n = placed.filter(({ pin }) => bounds.contains(pin.getLatLng())).reduce((sum, p) => sum + p.ids.length, 0);
    status.textContent =
      (n === 0 ? "No Vybes in this area. Zoom out to see more." : `${n} ${n === 1 ? "Vybe" : "Vybes"} in this area.`) +
      (onAnu ? " Starting from ANU, since your location isn't available." : "");
  }

  // opens on about START_KM around them, or around ANU
  function frame(spot: Spot) {
    map!.fitBounds(L.latLng(spot.lat, spot.lng).toBounds(START_KM * 2000));
  }

  function showYou(spot: Spot) {
    you ??= L.circleMarker([spot.lat, spot.lng], { radius: 7, className: "pin pin--you" })
      .bindTooltip("You")
      .addTo(map!);
    you.setLatLng([spot.lat, spot.lng]);
  }

  // Asking for location happens when someone chooses the map (the phone's
  // Map button, or "Use my location" on the map), never just because the
  // page loaded with the map showing, as it does on a laptop.
  async function findYou(ask: boolean) {
    const spot = await locate(ask);
    if (spot) {
      onAnu = false;
      frame(spot);
      showYou(spot);
    } else {
      onAnu = ask;
      countInView();
    }
  }

  async function openMap(ask: boolean) {
    if (map) {
      // Leaflet measures its box when it's created, and it was hidden
      map.invalidateSize();
      return;
    }
    map = L.map(box!);
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    pins.addTo(map);
    map.on("moveend", () => {
      countInView();
      reportViewing();
    });
    frame(ANU);
    placePins();
    addLocateButton();
    await findYou(ask);
  }

  // a "Use my location" button on the map, under the zoom buttons
  function addLocateButton() {
    const Locate = L.Control.extend({
      onAdd() {
        const button = L.DomUtil.create("button", "maplocate");
        button.type = "button";
        button.title = "Use my location";
        button.setAttribute("aria-label", "Use my location");
        button.innerHTML =
          '<svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>';
        L.DomEvent.disableClickPropagation(button);
        L.DomEvent.on(button, "click", () => findYou(true));
        return button;
      },
    });
    new Locate({ position: "topleft" }).addTo(map!);
  }

  // On a laptop, a card under the pointer and its pin light up together,
  // either way round.
  function pinFor(cardId: string) {
    return placed.find(({ ids }) => ids.includes(cardId))?.pin.getElement();
  }

  function hover(cardId: string, on: boolean) {
    document.getElementById(cardId)?.classList.toggle("invite--hover", on);
    pinFor(cardId)?.classList.toggle("pin--hover", on);
  }

  function show(view: "list" | "map") {
    document.documentElement.dataset.view = view;
    for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.viewButton === view));
    remember(view);
    if (view === "map") openMap(true);
    reportViewing();
  }

  // Wide enough for both: the list and the map side by side ("both"), and
  // the switch is hidden. Narrower: whichever this device last chose.
  const wide = window.matchMedia("(min-width: 60rem)");
  function fit() {
    if (wide.matches) {
      document.documentElement.dataset.view = "both";
      openMap(false);
      reportViewing();
    } else {
      show(remembered() === "map" ? "map" : "list");
    }
  }

  if (box) {
    for (const button of buttons) {
      button.addEventListener("click", () => show(button.dataset.viewButton === "map" ? "map" : "list"));
    }
    // the page swapped in fresh cards (see the live updates in index.astro)
    document.addEventListener("vybe:cards", () => {
      placePins();
      reportViewing();
    });
    document.addEventListener("vybe:viewers", (e) => {
      counts = (e as CustomEvent<Record<string, number>>).detail;
      showLooking();
    });
    document.addEventListener("mouseover", (e) => {
      const card = (e.target as Element).closest<HTMLElement>("[data-live] [data-going]");
      if (card) hover(card.id, true);
    });
    document.addEventListener("mouseout", (e) => {
      const card = (e.target as Element).closest<HTMLElement>("[data-live] [data-going]");
      if (card && !card.contains(e.relatedTarget as Node)) hover(card.id, false);
    });
    wide.addEventListener("change", fit);
    fit();
  }
</script>
