---
import { type InviteView, arrivalOptions } from "../lib/db";
import { dateBlock, formatClock, formatTimes } from "../lib/time";
import Avatar from "./Avatar.astro";
import Icon from "./Icon.astro";

// One Vybe, as it appears in "Your plans" (mine), "Open Vybes" (open) or
// "Past plans" (past): a calendar block, what, when and where, who's going,
// and one Join button.
interface Props {
  invite: InviteView;
  now: Date;
  personId: string;
  variant: "mine" | "open" | "past";
}

const { invite, now, personId, variant } = Astro.props;

const count = invite.going.length;
const full = count >= invite.size;
const started = invite.startsAt <= now;
const soon = !started && invite.startsAt.getTime() - now.getTime() < 60 * 60_000;
const hosting = invite.hostId === personId;
const arrival = variant === "open" && !full ? arrivalOptions(invite, now) : undefined;
// only ask when they'll get there if there's a choice to make
const onlyOnTime = arrival?.onTime && arrival.late.length === 0;
const block = dateBlock(invite.startsAt, now);
const when = variant === "past" ? formatClock(invite.startsAt) : formatTimes(invite.startsAt, now, invite.endsAt);
const faces = invite.going.slice(0, 4);
const minutesLate = (t: Date) => Math.round((t.getTime() - invite.startsAt.getTime()) / 60_000);
---

<li
  id={variant === "past" ? undefined : `invite-${invite.id}`}
  class={`invite invite--${variant}`}
  data-going={variant === "past" ? undefined : count}
  data-lat={variant === "past" ? undefined : invite.lat}
  data-lng={variant === "past" ? undefined : invite.lng}
  data-starts={variant === "past" ? undefined : invite.startsAt.getTime()}
>
  <div class="invite__main">
    <div class="datebox" aria-hidden="true">
      <span class="datebox__top">{block.top}</span>
      <span class="datebox__day">{block.day}</span>
    </div>
    <div class="invite__body">
      <div class="invite__head">
        <h3 class="invite__title">{invite.title}</h3>
        <div class="badges">
          {variant !== "past" && started && <span class="badge badge--live">Now</span>}
          {variant !== "past" && soon && <span class="badge badge--soon">Soon</span>}
          {variant === "mine" && <span class="badge badge--mine">{hosting ? "Hosting" : "Going"}</span>}
          {variant === "open" && full && <span class="badge">Full</span>}
        </div>
      </div>
      <p class="invite__line"><Icon name="clock" />{when}</p>
      <p class="invite__line">
        <Icon name="pin" /><span class="invite__place">{invite.place}</span>
        {/* filled in by the page once it knows where you are: "350 m away" */}
        {variant !== "past" && invite.lat !== null && (
          <span class="invite__distance" data-distance hidden><Icon name="walk" /><span /></span>
        )}
      </p>
    </div>
  </div>

  {
    variant === "past" ? (
      <p class="invite__names">
        With{" "}
        {invite.going
          .filter((g) => g.id !== personId)
          .map((g) => g.name)
          .join(", ") || "just you"}
      </p>
    ) : (
      <>
        <div class="invite__people">
          <div class="avatars">
            {faces.map((g) => (
              <Avatar name={g.name} />
            ))}
            {count > faces.length && <span class="avatar avatar--more">+{count - faces.length}</span>}
          </div>
          <span class="invite__tally">
            <span class="invite__count">{`${count} of ${invite.size} going`}</span>
            {/* filled in live by the page: how many others have this card on screen */}
            <span class="invite__viewers" data-viewers hidden />
          </span>
        </div>
        <div class="meter" aria-hidden="true">
          <span style={`width: ${Math.min(100, (count / invite.size) * 100)}%`} />
        </div>
      </>
    )
  }

  {
    variant === "mine" && (
      <div class="invite__foot">
        <p class="invite__names">
          {invite.going.map((g) => (g.arrivesAt ? `${g.name} (from ${formatClock(g.arrivesAt)})` : g.name)).join(", ")}
        </p>
        {!hosting && (
          <form method="post" action="/api/join">
            <input type="hidden" name="invite" value={invite.id} />
            <input type="hidden" name="action" value="leave" />
            <button class="button button--ghost button--small">Leave</button>
          </form>
        )}
      </div>
    )
  }

  {
    variant === "open" && (
      <div class="invite__foot">
        <p class="invite__names">Posted by {invite.host}</p>
        {arrival &&
          (onlyOnTime ? (
            <form method="post" action="/api/join" class="join">
              <input type="hidden" name="invite" value={invite.id} />
              <input type="hidden" name="arrival" value="start" />
              <button class="button button--small">Join</button>
            </form>
          ) : (
            <form method="post" action="/api/join" class="join">
              <input type="hidden" name="invite" value={invite.id} />
              <details class="join__more">
                <summary class="button button--small">
                  <span class="join__open">Join</span>
                  <span class="join__cancel">Cancel</span>
                </summary>
                <div class="join__pick">
                  <label class="field">
                    <span class="field__label">When can you get there?</span>
                    <select name="arrival">
                      {arrival.onTime && <option value="start">On time ({formatClock(invite.startsAt)})</option>}
                      {arrival.late.map((t) => (
                        <option value={t.getTime()}>
                          {formatClock(t)} ({minutesLate(t)} min late)
                        </option>
                      ))}
                    </select>
                  </label>
                  <button class="button">Confirm</button>
                </div>
              </details>
            </form>
          ))}
      </div>
    )
  }
</li>
